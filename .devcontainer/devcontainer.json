{
    "name": "Emission Factor ETL Pipeline",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "saoudrizwan.claude-dev",
                "altimate.vscode-dbt-power-user",
                "ms-python.python",
                "eamodio.gitlens",
                "mechatroner.rainbow-csv",
                "charliermarsh.ruff"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ],
    "runArgs": [
        "--env-file",
        "${localWorkspaceFolder}/.env",
        "--memory=6g",
        "--memory-swap=8g"
    ],
    "remoteEnv": {
        "UV_LINK_MODE": "copy"
    },
    // Creates a local .venv inside your project folder where you have 100% permissions
    "postCreateCommand": "if [ -f pyproject.toml ]; then uv venv --allow-existing && uv pip install -r pyproject.toml; fi",
    "remoteUser": "vscode"
}